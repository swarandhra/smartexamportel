# Frontend Environment Variables (Vite)
# Copy this file to .env in the root directory

# URL of the backend API server (defaults to http://localhost:3001 in local dev)
VITE_API_URL=http://localhost:3001

# Admin password for dashboard access
VITE_ADMIN_PASSWORD=Venky@905

# Supabase configuration (if used)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
